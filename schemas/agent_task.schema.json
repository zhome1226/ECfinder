    "input_refs": {"type": "object"},
    "prompt_refs": {"type": "array", "items": {"type": "string"}},
    "schema_ref": {"type": "string"},
    "output_expected": {"type": "string"},
    "status": {"type": "string"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": true
}
